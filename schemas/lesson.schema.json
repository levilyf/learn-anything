{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://learn-anything.dev/schemas/lesson.schema.json",
  "title": "Learn Anything lesson",
  "type": "object",
  "required": ["schema_version", "id", "subject", "title", "outcome", "practice", "assessment"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "id": {"type": "string"},
    "subject": {"type": "string"},
    "title": {"type": "string"},
    "outcome": {"type": "string"},
    "prerequisites": {"type": "array", "items": {"type": "string"}},
    "estimated_minutes": {"type": "integer", "minimum": 1},
    "practice": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "assessment": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  },
  "additionalProperties": false
}
